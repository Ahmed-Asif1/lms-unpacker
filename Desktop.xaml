<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMS Unpacker" Width="1120" Height="790" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontFamily="Segoe UI" FontSize="14" AllowDrop="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="3"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,9,0,9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="Padding" Value="0,14,0,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Margin="24,18,24,18" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="HelpButton" Content="_Visual guide" AutomationProperties.Name="Open the offline visual guide"/>
        <Button x:Name="StartMenuButton" Content="Add to _Start menu"/>
        <Button x:Name="RemoveShortcutButton" Content="Remove shortcut" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel><TextBlock Text="LMS Unpacker" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Unpack simply. Organize when you need to." Margin="0,3,8,0"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
      <Grid x:Name="PathPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Label Content="_Your folder or ZIP" Target="{Binding ElementName=InputPath}" Padding="0,0,0,6" FontWeight="SemiBold"/>
        <TextBox Grid.Row="1" x:Name="InputPath" AutomationProperties.Name="Selected folder or ZIP path" ToolTip="Drop one folder or ZIP anywhere in this window, use Browse, or paste a path."/>
        <Button Grid.Row="1" Grid.Column="1" x:Name="FolderButton" Content="Choose _folder…" Margin="10,0,8,0"/>
        <Button Grid.Row="1" Grid.Column="2" x:Name="ZipButton" Content="Choose _ZIP…" Margin="0"/>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Drop a folder or ZIP anywhere here. Results stay beside the ZIP or inside its course folder." Margin="0,8,0,0" TextWrapping="Wrap"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SettingsPanel" Margin="0,0,10,8">
          <TextBlock Text="1  Choose what to do" FontSize="19" FontWeight="SemiBold"/>
          <Label Content="_Task" Target="{Binding ElementName=TaskChoice}" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="TaskChoice" SelectedIndex="0" AutomationProperties.Name="Task">
            <ComboBoxItem Content="Flatten ZIP downloads"/><ComboBoxItem Content="Just unzip — keep original folders"/><ComboBoxItem Content="Organize ZIPs and loose documents"/><ComboBoxItem Content="Organize loose documents only"/>
          </ComboBox>
          <TextBlock x:Name="TaskHint" TextWrapping="Wrap" Margin="0,9,0,2"/>
          <StackPanel x:Name="OrganizationPanel" Visibility="Collapsed">
            <Label Content="_Course profile" Target="{Binding ElementName=ProfileChoice}" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ProfileChoice" SelectedIndex="0" AutomationProperties.Name="Course profile"><ComboBoxItem Content="General — any courses"/><ComboBoxItem Content="NUST Fall 2026 example"/><ComboBoxItem Content="My JSON profile"/></ComboBox>
            <StackPanel x:Name="CustomProfilePanel" Visibility="Collapsed" Margin="0,8,0,0"><TextBox x:Name="ProfilePath" AutomationProperties.Name="Custom JSON profile path"/><Button x:Name="ProfileBrowseButton" Content="Choose profile…" Margin="0,5,0,0"/></StackPanel>
            <Button x:Name="CreateProfileButton" Content="Create a profile from CSV…" Margin="0,8,0,0"/>
            <Label Content="_Group lectures" Target="{Binding ElementName=GroupChoice}" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="GroupChoice" SelectedIndex="0" AutomationProperties.Name="Lecture grouping"><ComboBoxItem Content="Categories only"/><ComboBoxItem Content="By week, when known"/><ComboBoxItem Content="By topic"/></ComboBox>
            <TextBlock x:Name="GroupHint" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
          <Label Content="Existing file_names" Target="{Binding ElementName=ConflictChoice}" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="ConflictChoice" SelectedIndex="0" AutomationProperties.Name="Existing filename policy"><ComboBoxItem Content="Skip existing names (default)"/><ComboBoxItem Content="Rename to keep different versions"/></ComboBox>
          <CheckBox x:Name="KeepZip" Content="_Keep ZIP after success" AutomationProperties.Name="Keep ZIP after success; unchecked means delete"/>
          <CheckBox x:Name="ScanChildren" Content="Include immediate course folders" IsChecked="True"/>
          <TextBlock x:Name="DefaultsNotice" TextWrapping="Wrap" Margin="0,4,0,14"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><Button x:Name="UndoButton" Content="_Undo organization…" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBlock Text="2  Review the plan" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Grid.Row="1" x:Name="SummaryText" Text="Choose your materials, then preview. Nothing changes until you apply." TextWrapping="Wrap" Margin="0,10,0,12" AutomationProperties.LiveSetting="Polite"/>
        <TabControl Grid.Row="2" x:Name="ResultsTabs" AutomationProperties.Name="Preview and activity">
          <TabItem Header="_File destinations"><DataGrid x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" EnableRowVirtualization="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" AutomationProperties.Name="Planned file destinations and reasons">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding FullDestination}"/></Style></DataGrid.RowStyle>
            <DataGrid.Columns><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="85"/><DataGridTextColumn Header="File" Binding="{Binding File}" Width="170"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="260"/><DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="280"/></DataGrid.Columns>
          </DataGrid></TabItem>
          <TabItem Header="_Activity and errors"><TextBox x:Name="ActivityText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Activity log and error details"/></TabItem>
        </TabControl>
        <TextBox Grid.Row="3" x:Name="JournalText" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0" AutomationProperties.Name="Saved undo record path"/>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock x:Name="StatusText" Text="Ready • Preview first" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="4" Margin="0,7,0,0" Visibility="Collapsed" AutomationProperties.Name="Working"/></StackPanel>
      <Button Grid.Column="1" x:Name="OpenFolderButton" Content="Open selected folder" IsEnabled="False"/>
      <Button Grid.Column="2" x:Name="PreviewButton" Content="_Preview changes" FontWeight="SemiBold"/>
      <Button Grid.Column="3" x:Name="ApplyButton" Content="_Apply changes" FontWeight="SemiBold" IsEnabled="False" Padding="22,10" Margin="0"/>
    </Grid>
  </Grid>
</Window>
